# Database
DATABASE_URL=postgresql+asyncpg://secureship:secureship@localhost:5432/secureship

# Ollama / LLM
OLLAMA_HOST=http://host.docker.internal:11434
LLM_MODEL=qwen3:8b
LLM_FALLBACK_MODEL=llama3.2:3b
LLM_TIMEOUT_SECONDS=60

# Session
SESSION_TTL_MINUTES=30
CODE_EXPIRY_MINUTES=10
MAX_CODE_ATTEMPTS=3
MAX_TOOL_ITERATIONS=8

# Auth0
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH0_CLIENT_ID=

# Seed
RUN_SEED=false
